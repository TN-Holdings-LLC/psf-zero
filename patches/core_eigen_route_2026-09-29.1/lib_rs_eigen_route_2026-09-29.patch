+/// Candidate (O1, O2) pairs from the eigenvectors of the real symmetric pencil of
+/// M = u_m^T u_m = O2^T D^2 O2, ordered by how well each diagonalizes u_m.
+///
+/// The SVD route works on Re(u_m), whose singular values are |cos(theta_k)|. Two
+/// well-separated magic-basis phases can still give nearly equal |cos| (both near
+/// 0, both near pi, or theta_i ~ pi - theta_j), and there the singular vectors are
+/// ill-conditioned even though the decomposition itself is not. M's eigenvalues
+/// exp(2 i theta_k) stay separated in that case, so O2 comes from an eigenbasis of
+/// cos(phi) Re(M) + sin(phi) Im(M), and each column of O1 from the matching column
+/// x of u_m O2^T as Re(x / sqrt(x^T x)).
+fn eigen_route_bases(u_m: &Mat4) -> Vec<SvdBasis> {
+    let m = u_m.transpose() * u_m;
+    let re = DMatrix::<f64>::from_fn(4, 4, |r, c| (m[(r, c)].re + m[(c, r)].re) * 0.5);
+    let im = DMatrix::<f64>::from_fn(4, 4, |r, c| (m[(r, c)].im + m[(c, r)].im) * 0.5);
+    let mut scored: Vec<(f64, SvdBasis)> = Vec::new();
+    for &phi in COMBINATION_ANGLES.iter() {
+        let a = &re * phi.cos() + &im * phi.sin();
+        let v = a.symmetric_eigen().eigenvectors;
+        let o2 = RMat4::from_fn(|r, c| v[(c, r)]);
+        let x = u_m * to_complex(&o2).transpose();
+        let mut o1 = RMat4::zeros();
+        let mut ok = true;
+        for k in 0..4 {
+            let col = x.column(k);
+            let s: Complex64 = col.iter().map(|z| z * z).sum();
+            let ph = s.sqrt();
+            if !ph.is_finite() || ph.norm() < 1e-12 {
+                ok = false;
+                break;
+            }
+            for r in 0..4 {
+                o1[(r, k)] = (col[r] / ph).re;
+            }
+        }
+        if !ok {
+            continue;
+        }
+        let d = to_complex(&o1).transpose() * u_m * to_complex(&o2).transpose();
+        let mut off = 0.0;
+        for r in 0..4 {
+            for c in 0..4 {
+                if r != c {
+                    off += d[(r, c)].norm_sqr();
+                }
+            }
+        }
+        scored.push((off.sqrt(), SvdBasis { o1, o2, s_sorted: [4.0, 3.0, 2.0, 1.0] }));
+    }
+    scored.sort_by(|a, b| a.0.total_cmp(&b.0));
+    scored.into_iter().map(|(_, b)| b).collect()
+}
