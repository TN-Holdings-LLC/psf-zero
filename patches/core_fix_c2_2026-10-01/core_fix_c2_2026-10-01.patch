+        if len(node.qargs) == 1:
+            k = 0 if node.qargs[0] == qubits[0] else 1
+            pend[k] = m if pend[k] is None else m @ pend[k]
+            continue
+        flush()
+        if node.qargs[0] != qubits[0]:
