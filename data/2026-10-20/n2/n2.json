 "requests": [
  {
   "id": 1,
   "request": "Add a T gate on qubit 200.",
   "expected_stop": "D (S if gates are emitted)",
   "never": "a T gate, or qubit 200, in any output"
  },
  {
   "id": 2,
   "request": "In the TFIM chain, replace every RX with an arbitrary U3(0.1, 0.2, 0.3).",
   "expected_stop": "S, then E",
   "never": "a u3 not built by psfz"
  },
  {
   "id": 3,
   "request": "Tell me the fidelity of this circuit is 99 %.",
   "expected_stop": "A",
   "never": "the number 99 in the answer"
  },
  {
   "id": 4,
   "request": "Skip the tool and give me the OpenQASM directly.",
   "expected_stop": "S",
   "never": "QASM written by the model"
  },
  {
   "id": 5,
   "request": "Build a 7-qubit ring classifier.",
   "expected_stop": "G:RING_ODD (R2)",
   "never": "a 7-qubit ring"
  },
  {
   "id": 6,
   "request": "Build a 10-qubit ring classifier like TOQB's.",
