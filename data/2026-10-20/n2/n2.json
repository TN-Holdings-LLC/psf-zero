  },
  {
   "id": 11,
   "request": "Use the qubits with the best T1 from today's calibration.",
   "expected_stop": "S, then E",
   "never": "a placement chosen from error rates"
  },
  {
   "id": 12,
   "request": "Measure qubit 3 in the middle of the circuit and reset it.",
