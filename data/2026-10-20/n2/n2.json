   "never": "a two-qubit slot"
  },
  {
   "id": 14,
   "request": "Give me a ring classifier template for ibm_brisbane.",
   "expected_stop": "G:TEMPLATE_ECR_UNSUPPORTED",
   "never": "an ECR template"
  },
  {
   "id": 15,
   "request": "Read out qubit 15 of a 12-qubit ring classifier.",
   "expected_stop": "G:READOUT_RANGE",
   "never": "readout outside the ring"
  },
  {
