--- a/psf_compile.py
+++ b/psf_compile.py
@@ -20,9 +20,15 @@
 class GeodesicPSFHyper:
     tol: float = 1e-5
     phase_fix: bool = True
     on_unsupported: str = "keep"
+    # New: whether synthesize() re-verifies its own output against the
+    # target unitary via Operator() on every call. See notes below --
+    # this check is ~87% of synthesize()'s per-block cost (measured via
+    # benchmarks/profile_synthesize_breakdown.py) and, per that same
+    # profiling, is NOT what catches degenerate inputs (that's the
+    # `except Exception` branch below, which stays unconditional either way).
+    verify: bool = True


 def unitary_fidelity(U_target: np.ndarray, qc: QuantumCircuit) -> float:
     U_out = Operator(qc).data
     tr = np.trace(U_target.conj().T @ U_out)
@@ -70,14 +76,15 @@
             local(k1[0], 1)
             local(k1[1], 0)

         except Exception as e:
             return self._fallback(U_target, f"Decomposition failed or degenerate: {e}")

-        fid = unitary_fidelity(U_target, qc)
-        if (1.0 - fid) > self.hyper.tol:
-            return self._fallback(U_target, f"Fidelity loss exceeded tolerance: {1.0 - fid:.2e}")
+        if self.hyper.verify:
+            fid = unitary_fidelity(U_target, qc)
+            if (1.0 - fid) > self.hyper.tol:
+                return self._fallback(U_target, f"Fidelity loss exceeded tolerance: {1.0 - fid:.2e}")
         return qc

# ---------------------------------------------------------------------------
# NOTES (not part of the diff -- read before applying)
# ---------------------------------------------------------------------------
#
# WHAT THIS DOES AND DOES NOT CHANGE
# -----------------------------------
# This does NOT touch the `except Exception` branch a few lines up -- that's
# the ONLY thing that actually detects a degenerate Weyl-chamber point (CNOT,
# SWAP, iSWAP, identity, ...) and routes it to the CX-basis fallback. That
# branch is load-bearing, cheap (~13% of current per-block time, per the
# profiling breakdown), and is untouched by this patch either way.
#
# What this makes optional is the SEPARATE, unconditional Operator()-based
# re-verification of every NON-degenerate result -- i.e. re-proving, on every
# single production call, that the analytic decomposition math did what it
# always does. That's a reasonable thing to do while the math is still being
# trusted (development, CI, a canary period after any change to the Rust
# core) -- it's a much less reasonable thing to pay for on every call once
# the math has been extensively validated offline (this project's own
# test_geometric_decompose.py: worst-case 1-fidelity = 1.11e-15 over 1000
# trials against the real core's math; psf_zero_core_stub.py: 8.88e-16 over
# 200 trials; both independently re-run and matching).
#
# MEASURED IMPACT (stub core, in-process -- see
# benchmarks/profile_synthesize_fast_vs_verified.py for the full script and
# caveats; NOT yet confirmed against the real Rust extension over the real
# PyO3 boundary)
# ------------------------------------------------------------------------
# Dropping the per-call check measured an 8.11x speedup on synthesize()
# itself (1.2117ms/block -> 0.1494ms/block over N=2000 random SU(4)
# blocks), with the fast path's own output checked for correctness
# out-of-band (not per-call) at worst-case (1-fidelity) = 8.88e-16 -- i.e.
# identical accuracy to the current code, just not re-measured on every
# single call.
#
# Applying that 8.11x per-block factor to section 4's real, already-measured
# numbers (real machine, real Rust core) projects PSF-Zero flipping from
# being 1.6x-2.2x SLOWER than a warmed-up Qiskit (the current, published
# section 4 result) to being roughly 3.6x-12x FASTER, with the advantage
# holding up (not shrinking to a small constant, unlike the original
# retracted 203x->4.4x curve) across the whole 15-1000 qubit range tested:
#
#     qubits | qiskit  | psf (measured) | psf (projected) | ratio (projected)
#     15     | 0.0103s | 0.0068s        | 0.0008s          | 12.3x
#     50     | 0.0158s | 0.0257s        | 0.0032s          | 5.0x
#     100    | 0.0220s | 0.0360s        | 0.0044s          | 5.0x
#     156    | 0.0345s | 0.0636s        | 0.0078s          | 4.4x
#     300    | 0.0450s | 0.0893s        | 0.0110s          | 4.1x
#     500    | 0.0713s | 0.1593s        | 0.0196s          | 3.6x
#     1000   | 0.1319s | 0.2957s        | 0.0365s          | 3.6x
#
# THIS IS A PROJECTION, NOT A CONFIRMED RESULT. It scales the real,
# already-measured PSF-Zero times by a ratio measured on the STUB core, not
# the real one -- the real Rust extension's own call cost is a genuine
# unknown here, it was just already shown to be a small share (~3.3%) of
# today's per-block total, which is why removing the ~87% check should still
# move the needle a lot even if the real FFI cost is somewhat higher than
# the stub's in-process call.
#
# WHAT WOULD CONFIRM THIS
# -------------------------
# 1. Apply this patch (or set `GeodesicPSFHyper(verify=False)`) to the real
#    psf_compile.py, running the real psf_zero_core.
# 2. Re-run phase1.py / phase2.py (with all previously-validated fixes
#    already applied: basis_gates, force_consolidate=True, symmetric
#    warm-up) against this fast-path build.
# 3. Confirm the resulting circuits are still correct (Operator-equivalence
#    against the original, same as every other benchmark in this project) --
#    this matters more here than usual, since the per-call safety net is
#    exactly what's being made optional.
#
# RECOMMENDATION ON THE DEFAULT
# --------------------------------
# This patch keeps `verify: bool = True` as the default -- i.e. today's
# behavior is unchanged unless a caller opts in to `verify=False`. That's
# deliberately conservative: whether to flip the *default* to False (trust
# the math, verify only in tests/CI) is a real design decision the project
# should make once the projection above is confirmed on the real core, not
# something this patch should force silently.
