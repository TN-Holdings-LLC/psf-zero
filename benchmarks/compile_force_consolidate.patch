--- a/psf_compile.py
+++ b/psf_compile.py
@@ -1,7 +1,7 @@
 def compile(qc: QuantumCircuit, block_gate_floor: int = DEFAULT_BLOCK_GATE_FLOOR) -> QuantumCircuit:
     def worth_consolidating(dag, block):
         return len(block) > block_gate_floor

     pm_consolidate = PassManager([
         Collect2qBlocks(filter_fn=worth_consolidating),
-        ConsolidateBlocks(kak_basis_gate=None),
+        ConsolidateBlocks(kak_basis_gate=None, force_consolidate=True),
     ])
     qc_blocked = pm_consolidate.run(qc)

# ---------------------------------------------------------------------------
# NOTES (not part of the diff -- read before applying)
# ---------------------------------------------------------------------------
#
# WHAT THE BUG IS
# ----------------
# Qiskit's `ConsolidateBlocks` pass defaults to `force_consolidate=False`.
# With that default, a candidate block made ENTIRELY of pre-existing
# 'unitary'-named nodes (i.e. a chain of `UnitaryGate` instructions already
# in the circuit -- as opposed to a chain of elementary gates like rz/ry/cx)
# is silently left UN-merged, even though `Collect2qBlocks` correctly
# identified it as one block and `worth_consolidating` correctly said it was
# worth consolidating. `force_consolidate=True` makes it merge these blocks
# too, exactly as intended.
#
# WHY IT MATTERS FOR `compile()`
# -------------------------------
# Any circuit built by repeatedly appending `UnitaryGate` objects to the
# same qubit pair (e.g. `for _ in range(N): qc.append(UnitaryGate(u), pair)`
# -- a completely ordinary way to build a Trotter step, a QAOA layer, or
# indeed this project's own `phase2.py` "dead zone" scale test) hits this
# exact case: with the default `force_consolidate=False`, `compile()`
# consolidates NOTHING and instead calls `SU4GeodesicPSFSynthesizer.synthesize()`
# once per ORIGINAL gate instead of once per PAIR. Since each synthesis call
# costs a near-fixed ~12-15 gates (and a near-fixed wall-clock time)
# regardless of input size, this multiplies both the output gate count and
# the compile time by (gates per pair) -- e.g. with 20 original gates per
# pair, both come out ~20x larger than they need to be.
#
# MEASURED (this project's sandbox, Rust core replaced by the verified
# psf_zero_core_stub -- see psf_compile_patched.py -- so ABSOLUTE times
# here do not transfer to a machine running the real Rust core; the
# STRUCTURE of the bug and the 20x multiplier are pure Qiskit-object-model
# facts, independent of which decomposition backend is behind
# `geometric_decompose`):
#
#   circuit: `phase2.py`'s own `build_dense_pair_blocks_circuit()`,
#   GATES_PER_PAIR=20, at 156/300/500/1000 qubits
#
#     qubits | output gates, as-is (bug) | output gates, force_consolidate=True | ratio
#     156    | 23400                     | 1170                                  | 20.0x
#     300    | 45000                     | 2250                                  | 20.0x
#     500    | 75000                     | 3750                                  | 20.0x
#     1000   | 150000                    | 7500                                  | 20.0x
#
#     qubits | compile time, as-is (bug) | compile time, force_consolidate=True | speedup
#     156    | 1.512s                    | 0.071s                                | 21.3x
#     300    | 2.719s                    | 0.127s                                | 21.4x
#     500    | 5.196s                    | 0.267s                                | 19.5x
#     1000   | 9.414s                    | 0.580s                                | 16.2x
#
# This is the same underlying Qiskit behavior already noted in this
# project's `experiment_fixed_compiler_fidelity.py` (which worked around it
# by building test circuits from elementary gates instead of raw
# `UnitaryGate` chains) -- but it had not previously been identified as a
# live defect in `compile()` itself, only as a benchmark-construction
# detail to avoid. It is: any real circuit assembled the same way `phase2.py`
# does hits it directly.
#
# WHAT THIS DOES NOT YET SETTLE
# -------------------------------
# The absolute compile-time numbers above come from this project's Python
# stand-in for the Rust core, not the real `psf_zero_core`. The relative
# claim (a ~20x reduction in redundant synthesis calls once merging works
# correctly) is a property of the pass pipeline and does not depend on that
# substitution, but confirming what this does to real wall-clock time
# against the real Rust core -- and against a FAIRLY configured Qiskit
# comparison (see `phase2_qiskit_worker.patch`: the original `phase2.py`
# calls `transpile(circuit, backend=None, optimization_level=3)`, which has
# no target basis to translate to and provably leaves every `UnitaryGate`
# untouched -- so its reported "Qiskit" time in the original run measured
# no actual synthesis work at all) -- is the natural next step.
